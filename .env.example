# Clerk. `npx clerk@latest init` writes the keys into .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/study
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/study

# Supabase. Use the service role on the server only. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to google/gemini-3.8-flash through the Vercel AI Gateway.
AI_TUTOR_MODEL=google/gemini-3.8-flash
